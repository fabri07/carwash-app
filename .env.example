# .env de la RAÍZ — solo variables de docker compose (dueño: deploy).
# Las variables de la aplicación están en backend/.env.example (dueño: backend)
# y frontend/.env.local.example (dueño: frontend).
#
# cp .env.example .env
#
# Estas credenciales son del Postgres LOCAL de docker compose y de nada más.
# POSTGRES_USER es el superusuario del contenedor: solo crea roles y corre los
# tests `postgres`. La API corre como carwash_app y migra como carwash_owner.
# No hay acá ninguna URL de base: docker-compose.yml la arma con estos valores
# y apunta siempre al contenedor `postgres`.

POSTGRES_DB=carwash
POSTGRES_USER=carwash
POSTGRES_PASSWORD=carwash
# Roles de la app (backend/scripts/create_roles.sh). CARWASH_APP_PASSWORD tiene que
# coincidir con APP_ROLE_PASSWORD de backend/app/tests/conftest_pg.py, y
# CARWASH_OWNER_PASSWORD con OWNER_ROLE_PASSWORD del mismo archivo.
CARWASH_OWNER_PASSWORD=carwash_owner_test
CARWASH_APP_PASSWORD=carwash_app_test
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000

# ── make check-envs (A11) ────────────────────────────────────────────────────
# Credenciales de un usuario SINTÉTICO de staging (ver backend/scripts/seed_staging.py).
# Nunca un usuario real.
CHECK_ENVS_EMAIL=owner@norte.staging.invalid
CHECK_ENVS_PASSWORD=
