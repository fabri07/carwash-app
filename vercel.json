{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "regions": [
    "gru1"
  ],
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
