# Origen de la API (sin /v1). En producción: https://api.carwashdetailapp.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Interruptor del service worker (ADR-0011 §6). "false" desregistra el SW existente y limpia sus cachés.
NEXT_PUBLIC_SW_ENABLED=false
# Sentry (opcional). Sin DSN el SDK no manda nada.
NEXT_PUBLIC_SENTRY_DSN=
# Prefijo de las cookies de sesión (contrato con el backend): "" en prod, "stg_" en staging.
NEXT_PUBLIC_COOKIE_NAME_PREFIX=
