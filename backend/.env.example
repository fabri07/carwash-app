# carwash.app backend — variables de la Fase 2.
# Copiar a `.env`. NUNCA apuntar a una base remota desde este archivo: el default es local.

# local | test | staging | production   (`Secure` en cookies fuera de `local`)
APP_ENV=local
DEBUG=false

# Runtime: rol `carwash_app` (no dueño, sin BYPASSRLS — ADR-0002).
DATABASE_URL=postgresql+asyncpg://carwash_app:carwash_app_test@localhost:5432/carwash
# Migraciones: rol dueño de las tablas (carwash_owner, nunca el superusuario). Lo resuelve `app/persistence/db/alembic_url.py`.
DATABASE_URL_SYNC=postgresql+psycopg2://carwash_owner:carwash_owner_test@localhost:5432/carwash

REDIS_URL=redis://localhost:6379/0

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# 7 días hasta que exista la revocación por dispositivo (F8).
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# `.carwashdetailapp.com` en staging/prod (ADR-0009). Vacío en local.
COOKIE_DOMAIN=
# Prefijo de los nombres de cookie: vacío en producción, `stg_` en staging.
COOKIE_NAME_PREFIX=
# CSV o JSON. También es la lista de `Origin` permitidos en métodos mutadores.
CORS_ORIGINS=http://localhost:3000

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logo del negocio en Cloudflare R2 (FASE-4-CONTRATO Y9, PR 4.5). Bucket PÚBLICO de solo
# logos: la clave es `logos/<tenant_id>/<sha256>.<ext>`. Los valores van solo en Railway
# (Variables del servicio), nunca acá. Con alguna vacía, subir el logo responde 503
# `STORAGE_UNAVAILABLE` y el resto de la app funciona.
#   R2_ACCOUNT_ID: id de la cuenta de Cloudflare (arma el endpoint S3).
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: token de API de R2 con "Object Read & Write"
#     limitado a ese bucket.
#   R2_BUCKET: nombre del bucket.
#   R2_PUBLIC_BASE_URL: URL pública del bucket (dominio propio o https://pub-<hash>.r2.dev),
#     sin barra final.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Railway lo inyecta solo; en local queda `unknown`.
# RAILWAY_GIT_COMMIT_SHA=
